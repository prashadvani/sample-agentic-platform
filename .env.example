# Copy to .env and fill in. Used by `make dev:deps` (docker-compose) and `make dev <agent>`.
# LOCAL DEV ONLY. `.env` is git-ignored — never commit real secrets.

# --- Environment mode ---
ENVIRONMENT=local
AWS_DEFAULT_REGION=us-west-2

# --- Postgres (must match docker-compose.yaml: user=dev pass=dev db=devdb) ---
PG_DATABASE=devdb
PG_CONNECTION_URL=localhost:5432
PG_USER=dev
PG_PASSWORD=dev
PG_READ_ONLY_USER=dev
PG_READ_ONLY_PASSWORD=dev

# --- LiteLLM gateway ---
# master_key protects the LiteLLM proxy/UI and is the key clients present.
LITELLM_MASTER_KEY=sk-local-dev-1234
# LiteLLM's own metadata DB. Inside the compose network, postgres is host "postgres".
LITELLM_DATABASE_URL=postgresql://dev:dev@postgres:5432/devdb
# Client-side: how agents reach the gateway and the key they send.
LITELLM_API_ENDPOINT=http://localhost:4000
LITELLM_KEY=sk-local-dev-1234

# --- Bedrock auth (optional) ---
# Leave blank to use the mounted ~/.aws credentials for Bedrock instead of a bearer token.
AWS_BEARER_TOKEN_BEDROCK=
